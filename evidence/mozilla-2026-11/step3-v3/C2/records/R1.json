    "name": "Improper Restriction of XML External Entity Reference"
  },
  "patch": {
    "id": "R1",
    "kind": "reference fix (hand-written)",
    "source_sha256": "3132205dc7f84ab039a550558a61ace4f67ac18c9b7f5c9744a1ba91bd8570bf",
    "source_path": "parapet/cases/C2/reference/R1/example/config/ConfigLoader.java"
  },
  "mechanism": {
    "route": "narrowed behavior",
    "description": "reject any DOCTYPE declaration (disallow-doctype-decl) plus FEATURE_SECURE_PROCESSING",
    "guidance": [
      "OWASP XML External Entity Prevention Cheat Sheet, Java, DocumentBuilderFactory (DOM): 'reject DOCTYPE declarations and leave XInclude disabled' (setFeature disallow-doctype-decl true; FEATURE_SECURE_PROCESSING true). https://cheatsheetseries.owasp.org/cheatsheets/XML_External_Entity_Prevention_Cheat_Sheet.html"
    ]
  },
  "diff": "--- a/example/config/ConfigLoader.java\n+++ b/example/config/ConfigLoader.java\n@@ -4,6 +4,7 @@\n import java.io.StringReader;\n import java.util.LinkedHashMap;\n import java.util.Map;\n+import javax.xml.XMLConstants;\n import javax.xml.parsers.DocumentBuilder;\n import javax.xml.parsers.DocumentBuilderFactory;\n import javax.xml.parsers.ParserConfigurationException;\n@@ -31,6 +32,11 @@\n     public static Map<String, String> load(String xml) throws IOException {\n         try {\n             DocumentBuilderFactory factory = DocumentBuilderFactory.newInstance();\n+            // Reject any document that contains a DOCTYPE declaration: without a\n+            // DTD there is no entity declaration, so no external entity or\n+            // external DTD subset can be resolved.\n+            factory.setFeature(\"http://apache.org/xml/features/disallow-doctype-decl\", true);\n+            factory.setFeature(XMLConstants.FEATURE_SECURE_PROCESSING, true);\n             DocumentBuilder builder = factory.newDocumentBuilder();\n             Document doc = builder.parse(new InputSource(new StringReader(xml)));\n             Element root = doc.getDocumentElement();\n",
